# ── Backend ────────────────────────────────────────────────────────────────────
# URL base del backend. En desarrollo local no hace falta (usa http://127.0.0.1:8000).
VITE_API_BASE=https://mi-crm.onrender.com

# Clave de API compartida con el backend (misma que CRM_API_KEY).
# En desarrollo local sin auth configurada tampoco hace falta.
VITE_API_KEY=

# ── Supabase Auth (opcional) ───────────────────────────────────────────────────
# Si definís estas dos variables, se activa el login con email/password de Supabase.
# Sin ellas, la app no muestra pantalla de login (acceso directo).
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_ANON_KEY=
