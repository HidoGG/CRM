# CRM IA Local - Variables de entorno
# Copiar a .env y completar con valores reales (nunca commitear .env)

# ---------------------------------------------------------------------------
# OpenAI - OCR por API y clasificacion asistida
# Requerido para: procesar PDFs escaneados, imagenes sin Tesseract local,
#                 y clasificacion inteligente de candidatos importados.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Modelo para OCR de archivos (PDF/imagen). Default: gpt-4.1-mini
# OPENAI_OCR_MODEL=gpt-4.1-mini

# Modelo para clasificacion de candidatos importados. Default: mismo que OCR
# OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Backend (valores actuales en server.py, documentados aqui para referencia)
# ---------------------------------------------------------------------------

# Host y puerto donde escucha el servidor HTTP
# CRM_HOST=127.0.0.1
# CRM_PORT=8000

# ---------------------------------------------------------------------------
# Tesseract OCR local (opcional)
# El backend lo detecta automaticamente en rutas estandar de Windows.
# Solo necesario si esta instalado en una ruta no estandar.
# ---------------------------------------------------------------------------
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
