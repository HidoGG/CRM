# CRM IA - Variables de entorno
# Copiar a .env y completar con valores reales (nunca commitear .env)

# ---------------------------------------------------------------------------
# Base de datos (Supabase PostgreSQL)
# Obtener desde: Supabase → Settings → Database → Connection string → URI
# Usar el string de conexion directa (no pgBouncer) para migraciones.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres

# ---------------------------------------------------------------------------
# OpenAI - OCR por API y clasificacion asistida
# Requerido para: PDFs escaneados, imagenes, clasificacion inteligente.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Modelo para OCR y clasificacion. Default: gpt-4o
# OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Puerto donde escucha uvicorn. Default: 8000
# PORT=8000

# ---------------------------------------------------------------------------
# CORS - frontend en produccion (Vercel u otro)
# Dejar vacio para solo permitir localhost en desarrollo.
# ---------------------------------------------------------------------------
# FRONTEND_URL=https://tu-app.vercel.app
