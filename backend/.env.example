# ── Base de datos ──────────────────────────────────────────────────────────────
# URL de Supabase pgBouncer (transaction mode, puerto 6543).
# Formato: postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Autenticación ──────────────────────────────────────────────────────────────
# Clave compartida con el frontend (X-API-Key). Generar con: openssl rand -hex 32
# Si no se define, la auth queda desactivada (útil para desarrollo local).
CRM_API_KEY=

# JWT Secret de Supabase Auth (opcional).
# Habilita login con Bearer token desde el frontend.
# Se obtiene en: Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Habilita OCR asistido por IA en importaciones. Sin esta key, sólo heurística local.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── URLs de la app ─────────────────────────────────────────────────────────────
# URL pública del backend (usada como redirect URI en OAuth de Gmail).
# En desarrollo local no hace falta definirla (usa http://localhost:8000).
BACKEND_URL=https://mi-crm.onrender.com

# URL pública del frontend (configura CORS en el backend).
# En desarrollo local no hace falta (acepta localhost:5173 y localhost:3000).
FRONTEND_URL=https://mi-crm.vercel.app

# Puerto del servidor. Render lo inyecta automáticamente.
PORT=8000

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Alternativa a colocar credentials.json en el directorio del backend.
# Obtener en: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase Storage (CVs) ─────────────────────────────────────────────────────
# URL del proyecto Supabase (ej: https://abc.supabase.co)
SUPABASE_URL=https://XXXX.supabase.co

# Service role key (NO la anon key). Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Nombre del bucket para CVs (debe existir en Storage y ser privado).
SUPABASE_STORAGE_BUCKET=cvs
